# Public frontend configuration. Copy to .env for local development.
# Set the same values in Netlify before rebuilding the deployed site.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Email provider keys and webhook secrets belong in Supabase Edge Function
# secrets, never in VITE_* variables or committed files.
